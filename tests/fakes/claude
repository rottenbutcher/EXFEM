#!/usr/bin/env python3
"""Fake `claude` for tests: auth status/login, --version, and `-p --output-format stream-json` that
drives the gfem MCP server from --mcp-config like Claude Code does."""
import json, os, subprocess, sys
a = sys.argv[1:]
if a[:1] == ["--version"]: print("9.9.9 (Claude Code fake)"); sys.exit(0)
if a[:2] == ["auth", "status"]:
    print(json.dumps({"loggedIn": os.environ.get("FAKE_LOGGED_IN", "1") == "1", "authMethod": "claude.ai"})); sys.exit(0)
if a[:2] == ["auth", "login"]:
    print("Opening browser to sign in…"); print("If the browser didn't open, visit: https://claude.example/oauth?x=1")
    sys.stdout.write("Paste code here if prompted > "); sys.stdout.flush()
    code = sys.stdin.readline().strip()
    print("Login successful." if code == "good" else "Invalid code."); sys.exit(0 if code == "good" else 1)
if a[:2] == ["auth", "logout"]: sys.exit(0)
assert "-p" in a and "--tools" in a and a[a.index("--tools") + 1] == ""
assert "build_cad" in open(a[a.index("--system-prompt-file") + 1], encoding="utf-8").read()
cfg = json.load(open(a[a.index("--mcp-config") + 1]))["mcpServers"]["gfem"]
msg = json.loads(sys.stdin.readline())["message"]["content"]
text = [c for c in msg if c["type"] == "text"][-1]["text"]
nimg = sum(c["type"] == "image" for c in msg)
p = subprocess.Popen([cfg["command"]] + cfg["args"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, env=dict(os.environ, **cfg["env"]))
def rpc(i, m, params=None):
    p.stdin.write(json.dumps(dict(jsonrpc="2.0", id=i, method=m, params=params or {})) + "\n"); p.stdin.flush()
    return json.loads(p.stdout.readline())
out = lambda e: print(json.dumps(e), flush=True)
rpc(1, "initialize", {"protocolVersion": "2025-06-18"})
out({"type": "system", "subtype": "init", "model": "claude-fake", "mcp_servers": [{"name": "gfem", "status": "connected"}]})
base = json.loads(rpc(2, "tools/call", {"name": "current_model", "arguments": {}})["result"]["content"][0]["text"])["features"]
feats = base or [dict(id="F1", type="box", dx=100, dy=60, dz=10)]
if base:
    feats = [dict(f, dz=20) if f["type"] == "box" else f for f in base]
bad = rpc(3, "tools/call", {"name": "build_cad", "arguments": {"name": "Block", "features": [dict(id="F1", type="box", dx=0)]}})
assert bad["result"]["isError"]
r = rpc(4, "tools/call", {"name": "build_cad", "arguments": {"name": "Block", "features": feats}})
assert not r["result"]["isError"] and r["result"]["content"][1]["type"] == "image"
out({"type": "assistant", "message": {"content": [{"type": "text", "text": f"Built the block (images {nimg})."}]}})
out({"type": "result", "subtype": "success", "is_error": False, "result": "ok",
     "usage": {"input_tokens": 10, "cache_creation_input_tokens": 5, "cache_read_input_tokens": 7, "output_tokens": 3}, "total_cost_usd": 0.001})
p.stdin.close(); p.wait()
